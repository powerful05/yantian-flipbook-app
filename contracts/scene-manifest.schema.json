{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yantian-flipbook.local/schemas/scene-manifest.schema.json",
  "title": "MVP SceneManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "world_id", "title", "start_scene_id", "scenes"],
  "properties": {
    "schema_version": { "const": "mvp-1" },
    "world_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "start_scene_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["inspect", "enter", "toggle"] },
        "target_scene_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "transition": { "enum": ["dive_to_anchor", "return_to_parent"] },
        "state_key": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "point", "bbox", "summary", "actions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
        "point": { "$ref": "#/$defs/point" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "asset_id": { "type": ["string", "null"], "maxLength": 200 },
        "z": { "type": "number" },
        "initial_state": { "type": "object" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scale_tier", "renderer", "camera", "entities"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scale_tier": { "enum": ["region", "place", "object"] },
        "renderer": { "enum": ["map", "terminal", "crane", "channel", "estuary", "custom"] },
        "asset": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["url", "width", "height", "mime_type"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "mime_type": { "type": "string", "minLength": 3 }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "zoom"],
          "properties": {
            "mode": { "const": "orthographic" },
            "zoom": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } }
      }
    }
  }
}
