DASHSCOPE_OPENAI_BASE_URL=https://ws-03hwkssn1m52nl33.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://ws-03hwkssn1m52nl33.cn-beijing.maas.aliyuncs.com/api/v1

QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_VL_MODEL=qwen3-vl-flash
QWEN_IMAGE_MODEL=qwen-image-3.0
WAN_TRANSITION_MODEL=wan2.2-kf2v-flash
WAN_AMBIENT_MODEL=wan2.6-i2v-flash

# Keep paid traffic disabled until you explicitly approve a sample run.
MODEL_REQUESTS_ENABLED=false
MOTION_GENERATION_MODE=off
MODEL_DAILY_BUDGET_CNY=20

# Optional: make the fixed local world the default at / (explicit ?demo=mvp always works).
MVP_WORLD_MODE=false

# Local reference images are sent as Base64 when this is true.
STYLE_REFERENCE_ENABLED=true
STYLE_REFERENCE_MANIFEST=fixtures/style-reference/yantian/manifest.json
STYLE_REFERENCE_MAX_IMAGES=3
# Optional in deployment: a public HTTPS prefix for the manifest files.
# STYLE_REFERENCE_BASE_URL=https://your-oss-domain.example/style-reference/yantian

PORT=4189
